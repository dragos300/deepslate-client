{
  "name": "deepslate-client",
  "version": "1.1.0-beta.1",
  "description": "Deepslate Minecraft launcher",
  "main": "./out/main/index.js",
  "author": "dragos300",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux tar.gz --publish never",
    "dist:linux:appimage": "npm run build && electron-builder --linux AppImage tar.gz --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:all": "npm run build && electron-builder --win nsis --linux AppImage --mac dmg --publish never",
    "copy-setups": "node scripts/copy-setups.mjs",
    "stamp-icon": "node scripts/stamp-icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/discord-rpc": "^4.0.8",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "rcedit": "^5.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.deepslate.client",
    "productName": "Deepslate Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "./scripts/afterPack.mjs",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../assets",
        "to": "assets",
        "filter": ["**/*"]
      },
      {
        "from": "../config.example.json",
        "to": "config.example.json"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "../assets/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "../assets/icon-1024.png",
      "category": "public.app-category.games",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "icon": "../assets/icon-1024.png",
      "category": "Game",
      "executableName": "deepslate-launcher",
      "synopsis": "Deepslate Minecraft launcher",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../assets/icon.ico",
      "uninstallerIcon": "../assets/icon.ico",
      "installerHeaderIcon": "../assets/icon.ico"
    }
  }
}
